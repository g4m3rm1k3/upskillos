{"source":"# Replace this ordinary Python with your own small program, or load a .py file.\n# No PyCade annotations or machine-learning variable names are required.\ndef predict_nearest(training, labels, query):\n    distances = [(value - query) ** 2 for value in training]\n    nearest_index = min(range(len(distances)), key=lambda i: distances[i])\n    return labels[nearest_index], distances, nearest_index\n\ntraining = [1.0, 2.0, 8.0, 9.0]\nlabels = [0, 0, 1, 1]\nquery = 7.0\nresult = predict_nearest(training, labels, query)\nprediction, distances, index = result\n","events":[{"line":3,"changes":{"predict_nearest":{"type":"function","value":"predict_nearest"}},"removed":[],"scope":1,"function":"<module>","stack":["<module>"],"returned":false},{"line":8,"changes":{"training":{"type":"list","items":[{"type":"float","value":1.0},{"type":"float","value":2.0},{"type":"float","value":8.0},{"type":"float","value":9.0}],"length":4,"truncated":false}},"removed":[],"scope":1,"function":"<module>","stack":["<module>"],"returned":false},{"line":9,"changes":{"labels":{"type":"list","items":[{"type":"int","value":0},{"type":"int","value":0},{"type":"int","value":1},{"type":"int","value":1}],"length":4,"truncated":false}},"removed":[],"scope":1,"function":"<module>","stack":["<module>"],"returned":false},{"line":10,"changes":{"query":{"type":"float","value":7.0}},"removed":[],"scope":1,"function":"<module>","stack":["<module>"],"returned":false},{"line":4,"changes":{"value":{"type":"float","value":1.0}},"removed":[],"scope":2,"function":"predict_nearest","stack":["<module>","predict_nearest"],"returned":false},{"line":4,"changes":{"value":{"type":"float","value":2.0}},"removed":[],"scope":2,"function":"predict_nearest","stack":["<module>","predict_nearest"],"returned":false},{"line":4,"changes":{"value":{"type":"float","value":8.0}},"removed":[],"scope":2,"function":"predict_nearest","stack":["<module>","predict_nearest"],"returned":false},{"line":4,"changes":{"value":{"type":"fl